    <wire from="(2720,1231)" to="(2760,1231)"/>
    <comp lib="0" loc="(2720,1231)" name="Tunnel"><a name="label" val="RESET"/><a name="width" val="1"/><a name="facing" val="east"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,911)" to="(3020,911)"/>
    <comp lib="0" loc="(3020,911)" name="Tunnel"><a name="label" val="A"/><a name="width" val="32"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,931)" to="(3020,931)"/>
    <comp lib="0" loc="(3020,931)" name="Tunnel"><a name="label" val="V0_10"/><a name="width" val="1"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,951)" to="(3020,951)"/>
    <comp lib="0" loc="(3020,951)" name="Tunnel"><a name="label" val="MEM_ADDR"/><a name="width" val="32"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,971)" to="(3020,971)"/>
    <comp lib="0" loc="(3020,971)" name="Tunnel"><a name="label" val="V0_11"/><a name="width" val="1"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,991)" to="(3020,991)"/>
    <comp lib="0" loc="(3020,991)" name="Tunnel"><a name="label" val="op"/><a name="width" val="6"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,1011)" to="(3020,1011)"/>
    <comp lib="0" loc="(3020,1011)" name="Tunnel"><a name="label" val="funct"/><a name="width" val="6"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,1031)" to="(3020,1031)"/>
    <comp lib="0" loc="(3020,1031)" name="Tunnel"><a name="label" val="TTY_DATA"/><a name="width" val="7"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,1051)" to="(3020,1051)"/>
    <comp lib="0" loc="(3020,1051)" name="Tunnel"><a name="label" val="B"/><a name="width" val="32"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,1071)" to="(3020,1071)"/>
    <comp lib="0" loc="(3020,1071)" name="Tunnel"><a name="label" val="MEM_WDATA"/><a name="width" val="32"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <wire from="(2980,1091)" to="(3020,1091)"/>
    <comp lib="0" loc="(3020,1091)" name="Tunnel"><a name="label" val="MEM_BE"/><a name="width" val="4"/><a name="facing" val="west"/><a name="labelfont" val="SansSerif bold 11"/></comp>
    <comp lib="7" loc="(1100,60)" name="Text"><a name="text" val="CPU: los cuatro bloques de la guia unidos entre si y con la placa"/><a name="font" val="SansSerif bold 18"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,90)" name="Text"><a name="text" val="COMO LEERLO: cada etiqueta (bandera) lleva el nombre de una senal. Todas las etiquetas con el MISMO nombre son el MISMO cable."/><a name="font" val="SansSerif bold 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,110)" name="Text"><a name="text" val="El nombre de cada etiqueta es el mismo que el del pin del bloque al que esta pegada, asi que se lee directamente."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,130)" name="Text"><a name="text" val="Los pines de la izquierda y de la derecha son los de la placa: no se han movido ni cambiado (regla R2)."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,150)" name="Text"><a name="text" val=""/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,170)" name="Text"><a name="text" val="ORDEN DE IZQUIERDA A DERECHA: primero quien decide y al final quien ejecuta."/><a name="font" val="SansSerif bold 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,190)" name="Text"><a name="text" val="1. Instruction_Decoder dice que instruccion es  -&gt;  2. Control_Unit decide que hace cada parte  -&gt;  3. Branch_Control decide si cambia el PC  -&gt;  4. Datapath lo ejecuta."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,210)" name="Text"><a name="text" val=""/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,230)" name="Text"><a name="text" val="QUIEN HABLA CON QUIEN"/><a name="font" val="SansSerif bold 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,250)" name="Text"><a name="text" val="1. Datapath -&gt; Instruction_Decoder: op y funct (la instruccion que hay en el IR)."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,270)" name="Text"><a name="text" val="2. Instruction_Decoder -&gt; Control_Unit: una salida por instruccion (es_add ... es_jal) e Illegal."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,290)" name="Text"><a name="text" val="3. Datapath -&gt; Control_Unit: V0_10 y V0_11 (que pide el syscall)."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,310)" name="Text"><a name="text" val="4. Control_Unit -&gt; Datapath: las senales de control (IR_Write, PC_Src, IorD, ALU_SrcA, ALU_SrcB, ALU_Op, Reg_Write, ...)."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,330)" name="Text"><a name="text" val="5. Control_Unit -&gt; Branch_Control: PC_Write, Branch_EQ, Branch_NE.   Datapath -&gt; Branch_Control: A y B."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,350)" name="Text"><a name="text" val="6. Branch_Control -&gt; Datapath: PC_En (si el PC se escribe en este ciclo)."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,370)" name="Text"><a name="text" val="7. Con la placa: Datapath da MEM_ADDR, MEM_WDATA, MEM_BE y TTY_DATA y recibe MEM_RDATA; Control_Unit da MEM_WE, TTY_WE y HALT."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1100,390)" name="Text"><a name="text" val="   CLK y RESET llegan directos a Datapath y a Control_Unit (sin logica en el camino del reloj, regla R3)."/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(540,850)" name="Text"><a name="text" val="1. INSTRUCTION_DECODER"/><a name="font" val="SansSerif bold 14"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(540,870)" name="Text"><a name="text" val="Dice que instruccion es (op, funct)"/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1280,850)" name="Text"><a name="text" val="2. CONTROL_UNIT"/><a name="font" val="SansSerif bold 14"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(1280,870)" name="Text"><a name="text" val="Decide que se hace en cada ciclo"/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(2020,850)" name="Text"><a name="text" val="3. BRANCH_CONTROL"/><a name="font" val="SansSerif bold 14"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(2020,870)" name="Text"><a name="text" val="Decide si el PC se escribe (beq, bne)"/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(2760,850)" name="Text"><a name="text" val="4. DATAPATH"/><a name="font" val="SansSerif bold 14"/><a name="halign" val="left"/></comp>
    <comp lib="7" loc="(2760,870)" name="Text"><a name="text" val="Ejecuta: PC, IR, registros, ALU y memoria"/><a name="font" val="SansSerif plain 12"/><a name="halign" val="left"/></comp>
  </circuit>
