  <circuit name="Branch_Control">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Branch_Control"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(200,620)" name="Pin">
      <a name="label" val="A"/>
      <a name="width" val="32"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="0" loc="(200,760)" name="Pin">
      <a name="label" val="B"/>
      <a name="width" val="32"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="3" loc="(420,700)" name="Comparator">
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(640,300)" name="Pin">
      <a name="label" val="PC_Write"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="0" loc="(640,480)" name="Pin">
      <a name="label" val="Branch_EQ"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="0" loc="(640,880)" name="Pin">
      <a name="label" val="Branch_NE"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="1" loc="(800,500)" name="AND Gate">
      <a name="inputs" val="2"/>
      <a name="size" val="50"/>
    </comp>
    <comp lib="1" loc="(680,920)" name="NOT Gate">
    </comp>
    <comp lib="1" loc="(800,900)" name="AND Gate">
      <a name="inputs" val="2"/>
      <a name="size" val="50"/>
    </comp>
    <comp lib="1" loc="(1060,700)" name="OR Gate">
      <a name="inputs" val="3"/>
      <a name="size" val="50"/>
    </comp>
    <comp lib="0" loc="(1160,700)" name="Pin">
      <a name="label" val="PC_En"/>
      <a name="type" val="output"/>
      <a name="facing" val="west"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="7" loc="(40,40)" name="Text">
      <a name="text" val="Branch_Control: decide si el PC se escribe en este ciclo"/>
      <a name="font" val="SansSerif bold 18"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,70)" name="Text">
      <a name="text" val="Es combinacional: no guarda nada, la salida cambia en cuanto cambian las entradas."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,90)" name="Text">
      <a name="text" val="PC_En = 1 significa: en el proximo flanco de subida de CLK, el PC toma el valor que elige PC_Src en Datapath."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,110)" name="Text">
      <a name="text" val="Este circuito solo dice SI o NO se escribe el PC. QUE valor entra lo decide PC_Src."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,130)" name="Text">
      <a name="text" val="Formula:   PC_En = PC_Write  o  (Branch_EQ y A = B)  o  (Branch_NE y A distinto de B)"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,150)" name="Text">
      <a name="text" val="Se lee de izquierda a derecha: 1. comparar   2 y 3. decidir cada salto   4. juntar todo en PC_En"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(560,250)" name="Text">
      <a name="text" val="PC_Write (de Control_Unit): escribir el PC SIN condicion"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(560,270)" name="Text">
      <a name="text" val="Vale 1 en DECOD (PC + 100), SALTAR (j), LLAMAR (jal) y VOLVER (jr)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,520)" name="Text">
      <a name="text" val="ENTRADAS DE DATOS (de Datapath, 32 bits)"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,540)" name="Text">
      <a name="text" val="A = valor del registro rs"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,560)" name="Text">
      <a name="text" val="B = valor del registro rt"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,840)" name="Text">
      <a name="text" val="1. COMPARADOR (el bloque con =)"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,860)" name="Text">
      <a name="text" val="Su salida = vale 1 si los 32 bits de A"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,880)" name="Text">
      <a name="text" val="y B son iguales. La llamamos eq."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(40,900)" name="Text">
      <a name="text" val="Las salidas &gt; y &lt; no se usan."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(560,410)" name="Text">
      <a name="text" val="2. SALTO DE beq:  salta_beq = Branch_EQ y eq"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(560,430)" name="Text">
      <a name="text" val="Branch_EQ = 1 solo en el estado RAMA con beq"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(560,810)" name="Text">
      <a name="text" val="3. SALTO DE bne:  salta_bne = Branch_NE y distintos"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(560,830)" name="Text">
      <a name="text" val="Branch_NE = 1 solo en el estado RAMA con bne"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(560,960)" name="Text">
      <a name="text" val="NOT: distintos = NO eq  (1 si A no es igual a B)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1000,600)" name="Text">
      <a name="text" val="4. PC_En = PC_Write o salta_beq o salta_bne"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1000,620)" name="Text">
      <a name="text" val="Sale hacia Datapath: habilita escribir el PC"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1260,360)" name="Text">
      <a name="text" val="TABLA DE VERDAD"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1260,380)" name="Text">
      <a name="text" val="PC_Write"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1340,380)" name="Text">
      <a name="text" val="Branch_EQ"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
