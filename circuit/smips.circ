    <comp lib="7" loc="(1270,360)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001111"/>
    </comp>
    <comp lib="7" loc="(1370,360)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = inm seguido de 16 ceros"/>
    </comp>
    <comp lib="7" loc="(1720,360)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Cargar la mitad alta de un numero grande"/>
    </comp>
    <comp lib="7" loc="(2010,360)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lui $t0,1: $t0=0000000000000001 0000000000000000"/>
    </comp>
    <comp lib="7" loc="(1200,390)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="MEMORIA (d = rs + inm es la direccion)"/>
    </comp>
    <comp lib="7" loc="(1200,410)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lw"/>
    </comp>
    <comp lib="7" loc="(1270,410)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="100011"/>
    </comp>
    <comp lib="7" loc="(1370,410)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = palabra que hay en d"/>
    </comp>
    <comp lib="7" loc="(1720,410)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Leer un numero de memoria"/>
    </comp>
    <comp lib="7" loc="(2010,410)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lw $t0,4($t1)  con $t1=1000: copia a $t0 la palabra de 1100"/>
    </comp>
    <comp lib="7" loc="(1200,430)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sw"/>
    </comp>
    <comp lib="7" loc="(1270,430)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="101011"/>
    </comp>
    <comp lib="7" loc="(1370,430)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Palabra en d = rt"/>
    </comp>
    <comp lib="7" loc="(1720,430)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Guardar un numero en memoria"/>
    </comp>
    <comp lib="7" loc="(2010,430)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sw $t0,4($t1)  con $t1=1000: copia $t0 a la palabra de 1100"/>
    </comp>
    <comp lib="7" loc="(1200,450)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lb"/>
