    </comp>
    <comp lib="7" loc="(1370,450)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = byte en d, rellenado con su bit de signo"/>
    </comp>
    <comp lib="7" loc="(1720,450)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Leer un byte como numero con signo"/>
    </comp>
    <comp lib="7" loc="(2010,450)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lb con byte 11111111: $t0 = 32 unos (-1)"/>
    </comp>
    <comp lib="7" loc="(1200,470)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lbu"/>
    </comp>
    <comp lib="7" loc="(1270,470)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="100100"/>
    </comp>
    <comp lib="7" loc="(1370,470)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = byte en d, rellenado con ceros"/>
    </comp>
    <comp lib="7" loc="(1720,470)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Leer un byte sin signo (un caracter)"/>
    </comp>
    <comp lib="7" loc="(2010,470)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lbu con byte 11111111: $t0 = 24 ceros y 11111111 (255)"/>
    </comp>
    <comp lib="7" loc="(1200,490)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sb"/>
    </comp>
    <comp lib="7" loc="(1270,490)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="101000"/>
    </comp>
    <comp lib="7" loc="(1370,490)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Byte en d = 8 bits bajos de rt"/>
    </comp>
    <comp lib="7" loc="(1720,490)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Guardar un caracter sin tocar los otros 3 bytes"/>
    </comp>
    <comp lib="7" loc="(2010,490)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sb $t0,1($t1)  con $t1=1000: escribe solo el byte 1001"/>
    </comp>
    <comp lib="7" loc="(1200,520)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="SALTOS (cambian el PC)"/>
    </comp>
    <comp lib="7" loc="(1200,540)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="beq"/>
    </comp>
    <comp lib="7" loc="(1270,540)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="000100"/>
    </comp>
    <comp lib="7" loc="(1370,540)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Si rs = rt: PC = PC + 4 + inm x 4"/>
    </comp>
    <comp lib="7" loc="(1720,540)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Condiciones: saltar si son iguales"/>
    </comp>
    <comp lib="7" loc="(2010,540)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="PC=1000, inm=11, rs=rt: PC=11000"/>
    </comp>
    <comp lib="7" loc="(1200,560)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="bne"/>
    </comp>
    <comp lib="7" loc="(1270,560)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="000101"/>
    </comp>
    <comp lib="7" loc="(1370,560)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Si rs != rt: PC = PC + 4 + inm x 4"/>
    </comp>
    <comp lib="7" loc="(1720,560)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Bucles: repetir mientras sean distintos"/>
    </comp>
    <comp lib="7" loc="(2010,560)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="PC=1000, inm=11, rs!=rt: PC=11000"/>
    </comp>
    <comp lib="7" loc="(1200,580)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="j"/>
    </comp>
    <comp lib="7" loc="(1270,580)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="000010"/>
    </comp>
    <comp lib="7" loc="(1370,580)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="PC = 4 bits altos de PC+4 | dir | 00"/>
    </comp>
    <comp lib="7" loc="(1720,580)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Saltar siempre a una etiqueta"/>
    </comp>
    <comp lib="7" loc="(2010,580)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="j con dir terminada en 0101: PC termina en 10100"/>
    </comp>
    <comp lib="7" loc="(1200,600)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="jal"/>
    </comp>
    <comp lib="7" loc="(1270,600)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="000011"/>
    </comp>
    <comp lib="7" loc="(1370,600)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="$ra = PC + 4 y salta como j"/>
    </comp>
    <comp lib="7" loc="(1720,600)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Llamar a una funcion"/>
    </comp>
    <comp lib="7" loc="(2010,600)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="jal con PC=1000: $ra=1100"/>
    </comp>
    <comp lib="7" loc="(1200,630)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="ARITMETICAS Y LOGICAS (op = 000000)"/>
    </comp>
    <comp lib="7" loc="(1200,650)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="add"/>
    </comp>
    <comp lib="7" loc="(1270,650)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="100000"/>
    </comp>
    <comp lib="7" loc="(1370,650)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rd = rs + rt"/>
    </comp>
    <comp lib="7" loc="(1720,650)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Sumar dos registros"/>
    </comp>
    <comp lib="7" loc="(2010,650)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="add $t0,$t1,$t2  con 0101 y 0011: $t0=1000"/>
    </comp>
    <comp lib="7" loc="(1200,670)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="addu"/>
    </comp>
    <comp lib="7" loc="(1270,670)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="100001"/>
    </comp>
    <comp lib="7" loc="(1370,670)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Igual que add"/>
    </comp>
    <comp lib="7" loc="(1720,670)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="La genera MARS al traducir move"/>
    </comp>
    <comp lib="7" loc="(2010,670)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="move $t0,$t1 pasa a addu $t0,$zero,$t1"/>
    </comp>
    <comp lib="7" loc="(1200,690)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sub"/>
    </comp>
    <comp lib="7" loc="(1270,690)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="100010"/>
    </comp>
    <comp lib="7" loc="(1370,690)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rd = rs - rt"/>
    </comp>
    <comp lib="7" loc="(1720,690)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Restar dos registros"/>
    </comp>
    <comp lib="7" loc="(2010,690)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sub $t0,$t1,$t2  con 0101 y 0011: $t0=0010"/>
    </comp>
    <comp lib="7" loc="(1200,710)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="and"/>
    </comp>
    <comp lib="7" loc="(1270,710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="100100"/>
    </comp>
    <comp lib="7" loc="(1370,710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rd = rs AND rt, bit a bit"/>
    </comp>
    <comp lib="7" loc="(1720,710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Quedarse solo con algunos bits"/>
    </comp>
    <comp lib="7" loc="(2010,710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="and $t0,$t1,$t2  con 0110 y 0011: $t0=0010"/>
    </comp>
    <comp lib="7" loc="(1200,730)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="or"/>
    </comp>
    <comp lib="7" loc="(1270,730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="100101"/>
    </comp>
    <comp lib="7" loc="(1370,730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rd = rs OR rt, bit a bit"/>
    </comp>
    <comp lib="7" loc="(1720,730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Combinar los bits de dos registros"/>
    </comp>
    <comp lib="7" loc="(2010,730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="or $t0,$t1,$t2  con 0110 y 0011: $t0=0111"/>
    </comp>
    <comp lib="7" loc="(1200,750)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="slt"/>
    </comp>
    <comp lib="7" loc="(1270,750)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="101010"/>
    </comp>
    <comp lib="7" loc="(1370,750)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rd = 1 si rs &lt; rt (con signo); si no, 0"/>
    </comp>
    <comp lib="7" loc="(1720,750)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Comparar: es rs menor que rt?"/>
    </comp>
    <comp lib="7" loc="(2010,750)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="slt con rs = 32 unos (-1) y rt=0001: rd=1"/>
    </comp>
    <comp lib="7" loc="(1200,770)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sll"/>
    </comp>
    <comp lib="7" loc="(1270,770)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="000000"/>
    </comp>
    <comp lib="7" loc="(1370,770)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rd = rt desplazado a la izquierda shamt veces"/>
    </comp>
    <comp lib="7" loc="(1720,770)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Multiplicar por 2 shamt veces"/>
    </comp>
    <comp lib="7" loc="(2010,770)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="sll $t0,$t1,2  con $t1=0101: $t0=10100"/>
    </comp>
    <comp lib="7" loc="(1200,790)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="srl"/>
    </comp>
    <comp lib="7" loc="(1270,790)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="000010"/>
    </comp>
    <comp lib="7" loc="(1370,790)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rd = rt desplazado a la derecha; entran ceros"/>
    </comp>
    <comp lib="7" loc="(1720,790)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Dividir entre 2 shamt veces"/>
    </comp>
    <comp lib="7" loc="(2010,790)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="srl $t0,$t1,2  con $t1=10100: $t0=00101"/>
    </comp>
    <comp lib="7" loc="(1200,820)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="SALTO POR REGISTRO (op = 000000)"/>
    </comp>
    <comp lib="7" loc="(1200,840)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="jr"/>
    </comp>
    <comp lib="7" loc="(1270,840)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001000"/>
    </comp>
    <comp lib="7" loc="(1370,840)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="PC = rs"/>
    </comp>
    <comp lib="7" loc="(1720,840)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Volver de una funcion"/>
    </comp>
    <comp lib="7" loc="(2010,840)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="jr $ra  con $ra=1100: PC=1100"/>
    </comp>
    <comp lib="7" loc="(1200,870)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="ENTORNO (op = 000000)"/>
    </comp>
    <comp lib="7" loc="(1200,890)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="syscall"/>
    </comp>
    <comp lib="7" loc="(1270,890)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001100"/>
    </comp>
    <comp lib="7" loc="(1370,890)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Pide un servicio segun $v0"/>
    </comp>
    <comp lib="7" loc="(1720,890)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="$v0=1011: imprimir; $v0=1010: terminar"/>
    </comp>
    <comp lib="7" loc="(2010,890)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="$v0=1011 y $a0=1000001: imprime A en el TTY"/>
    </comp>
    <comp lib="7" loc="(1200,930)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="CASOS ESPECIALES"/>
    </comp>
    <comp lib="7" loc="(1200,950)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="nop: la palabra de 32 ceros es sll $zero,$zero,0. Activa es_sll y no tiene efecto, porque $zero nunca cambia."/>
    </comp>
    <comp lib="7" loc="(1200,970)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Illegal: si op y funct no coinciden con ninguna fila, ninguna salida es_ se activa, Illegal vale 1 y el CPU se detiene como con $v0=1010."/>
    </comp>
