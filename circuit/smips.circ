    </comp>
    <comp lib="7" loc="(130,90)" name="Text">
      <a name="text" val="Cada senal de control es un pin que mira hacia arriba, justo debajo del multiplexor o registro que manda."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(130,110)" name="Text">
      <a name="text" val="Se lee de izquierda a derecha:   1. PC   -&gt;   2. MEMORIA   -&gt;   3. IR Y CAMPOS   -&gt;   4. BANCO DE REGISTROS   -&gt;   5. OPERANDOS Y ALU   -&gt;   6. SALIDAS"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(130,130)" name="Text">
      <a name="text" val="Arriba, 6 carriles largos llevan un valor de una seccion a otra; cada uno tiene su nombre escrito encima. Dos cables que se cruzan sin punto NO estan conectados."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(380,176)" name="Text">
      <a name="text" val="CLK (reloj, directo a PC, IR y banco de registros)"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(380,196)" name="Text">
      <a name="text" val="A = registro rs  (para jr)"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(380,216)" name="Text">
      <a name="text" val="destino de j / jal"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(380,236)" name="Text">
      <a name="text" val="resultado de la ALU"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(600,276)" name="Text">
      <a name="text" val="PC"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1280,256)" name="Text">
      <a name="text" val="dato leido de memoria"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(190,1576)" name="Text">
      <a name="text" val="CLK"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(190,1596)" name="Text">
      <a name="text" val="RESET"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(960,1676)" name="Text">
      <a name="text" val="d[1:0] = byte dentro de la palabra (para sb)"/>
      <a name="font" val="SansSerif bold 10"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,330)" name="Text">
      <a name="text" val="1. PC"/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,620)" name="Text">
      <a name="text" val="1. PC (contador de programa)"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,640)" name="Text">
      <a name="text" val="Direccion de la instruccion actual."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,660)" name="Text">
      <a name="text" val="Se escribe solo si PC_En = 1"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,680)" name="Text">
      <a name="text" val="(PC_En lo calcula Branch_Control)."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,700)" name="Text">
      <a name="text" val="PC_Src elige el PC nuevo:"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,720)" name="Text">
      <a name="text" val="00: resultado de la ALU"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,740)" name="Text">
      <a name="text" val="      (PC + 100, o destino de beq/bne)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,760)" name="Text">
      <a name="text" val="01: destino de j y jal"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,780)" name="Text">
      <a name="text" val="10: registro rs (jr)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(180,800)" name="Text">
      <a name="text" val="RESET lo pone a 0."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(600,330)" name="Text">
      <a name="text" val="2. MEMORIA"/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,920)" name="Text">
      <a name="text" val="2. MEMORIA"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,940)" name="Text">
      <a name="text" val="IorD elige la direccion: 0 = PC (leer la"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,960)" name="Text">
      <a name="text" val="instruccion), 1 = resultado de la ALU"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,980)" name="Text">
      <a name="text" val="(lw, sw, lb, lbu, sb)."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,1000)" name="Text">
      <a name="text" val="d[1:0] = byte dentro de la palabra."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,1020)" name="Text">
      <a name="text" val="lb y lbu: el multiplexor de 8 bits saca el"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,1040)" name="Text">
      <a name="text" val="byte d[1:0]; se extiende con signo"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,1060)" name="Text">
      <a name="text" val="(Load_Unsigned = 0) o con ceros (= 1)."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,1080)" name="Text">
      <a name="text" val="Load_Byte = 1: al registro va ese byte;"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(940,1100)" name="Text">
      <a name="text" val="Load_Byte = 0: va la palabra entera."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1290,640)" name="Text">
      <a name="text" val="3. IR Y CAMPOS"/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,880)" name="Text">
      <a name="text" val="3. IR Y CAMPOS"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,900)" name="Text">
      <a name="text" val="IR guarda la instruccion (IR_Write = 1, en LEER)."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,920)" name="Text">
      <a name="text" val="Los separadores sacan sus campos:"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,940)" name="Text">
      <a name="text" val="op [31:26] y funct [5:0]  -&gt;  Instruction_Decoder"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,960)" name="Text">
      <a name="text" val="rs y rt [25:16]  -&gt;  registros que se leen"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,980)" name="Text">
      <a name="text" val="rt [20:16] y rd [15:11]  -&gt;  registro que se escribe"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,1000)" name="Text">
      <a name="text" val="shamt [10:6]  -&gt;  desplazamientos (sll, srl)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,1020)" name="Text">
      <a name="text" val="inm [15:0]  -&gt;  operando B de la ALU"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1500,1040)" name="Text">
      <a name="text" val="destino [25:0]  -&gt;  salto j / jal"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1620,396)" name="Text">
      <a name="text" val="j / jal:  { PC[31:28], destino, 00 }"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,330)" name="Text">
      <a name="text" val="4. BANCO DE REGISTROS"/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,880)" name="Text">
      <a name="text" val="4. BANCO DE REGISTROS"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,900)" name="Text">
      <a name="text" val="Lee 2 registros (A = rs, B = rt) y"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,920)" name="Text">
      <a name="text" val="escribe 1 (si Reg_Write = 1)."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,940)" name="Text">
      <a name="text" val="Syscall_Regs = 1: lee 00010 ($v0)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,960)" name="Text">
      <a name="text" val="y 00100 ($a0) en vez de rs y rt."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,980)" name="Text">
      <a name="text" val="Reg_Dst: 00 rt, 01 rd, 10 = 11111"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,1000)" name="Text">
      <a name="text" val="($ra, para jal)."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,1020)" name="Text">
      <a name="text" val="Mem_To_Reg (dato que se escribe):"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2010,1040)" name="Text">
      <a name="text" val="00 ALU, 01 memoria, 10 PC (jal)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2740,330)" name="Text">
      <a name="text" val="5. OPERANDOS Y ALU"/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,860)" name="Text">
      <a name="text" val="5. OPERANDOS Y ALU"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,880)" name="Text">
      <a name="text" val="ALU_SrcA (operando A): 00 PC, 01 A (rs), 10 B (rt, para sll/srl)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,900)" name="Text">
      <a name="text" val="ALU_SrcB (operando B):"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,920)" name="Text">
      <a name="text" val="000 B (rt)          001 constante 100 (4)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,940)" name="Text">
      <a name="text" val="010 inm con signo          011 inm con ceros"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,960)" name="Text">
      <a name="text" val="100 inm con signo x 100 (x 4: dos ceros a la derecha)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,980)" name="Text">
      <a name="text" val="101 shamt          110 inm seguido de 16 ceros (lui)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,1000)" name="Text">
      <a name="text" val="Es la UNICA ALU del CPU: calcula PC + 100, direcciones,"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2700,1020)" name="Text">
      <a name="text" val="destinos de salto y todas las operaciones (regla R14)."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1220)" name="Text">
      <a name="text" val="6. SALIDAS HACIA OTROS CIRCUITOS"/>
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1240)" name="Text">
      <a name="text" val="A y B  -&gt;  Branch_Control (comparar en beq y bne)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1260)" name="Text">
      <a name="text" val="V0_10 = 1 si A ($v0) = 1010;  V0_11 = 1 si A = 1011"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1280)" name="Text">
      <a name="text" val="      -&gt;  Control_Unit (syscall 10 termina, 11 imprime)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1300)" name="Text">
      <a name="text" val="TTY_DATA = B[6:0] ($a0): el caracter que se imprime"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1320)" name="Text">
      <a name="text" val=""/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1340)" name="Text">
      <a name="text" val="ESCRIBIR EN MEMORIA (Store_Byte)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1360)" name="Text">
      <a name="text" val="sw: MEM_WDATA = B entero y MEM_BE = 1111"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1380)" name="Text">
      <a name="text" val="sb: el byte B[7:0] se copia en los 4 carriles y MEM_BE"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(2780,1400)" name="Text">
      <a name="text" val="      activa solo el byte d[1:0] (decodificador 2 a 4)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
