    </comp>
    <comp lib="7" loc="(1370,340)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = rs OR inm (inm rellenado con ceros)"/>
    </comp>
    <comp lib="7" loc="(1720,340)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Poner algunos bits a 1"/>
    </comp>
    <comp lib="7" loc="(2010,340)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="ori $t0,$t1,3  con $t1=0100: $t0=0111"/>
    </comp>
    <comp lib="7" loc="(1200,360)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="lui"/>
