    </comp>
    <comp lib="7" loc="(1720,200)" name="Text">
      <a name="font" val="SansSerif bold 13"/>
      <a name="halign" val="left"/>
      <a name="text" val="Para que sirve"/>
    </comp>
    <comp lib="7" loc="(2010,200)" name="Text">
      <a name="font" val="SansSerif bold 13"/>
      <a name="halign" val="left"/>
      <a name="text" val="Ejemplo"/>
    </comp>
    <comp lib="7" loc="(1200,240)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="CON INMEDIATO (el segundo dato esta dentro de la instruccion)"/>
    </comp>
    <comp lib="7" loc="(1200,260)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="addi"/>
    </comp>
    <comp lib="7" loc="(1270,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001000"/>
    </comp>
    <comp lib="7" loc="(1370,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = rs + inm (inm con signo)"/>
    </comp>
    <comp lib="7" loc="(1720,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Sumar o restar una constante"/>
    </comp>
    <comp lib="7" loc="(2010,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="addi $t0,$t1,2  con $t1=0101: $t0=0111"/>
    </comp>
    <comp lib="7" loc="(1200,280)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="addiu"/>
    </comp>
    <comp lib="7" loc="(1270,280)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001001"/>
    </comp>
    <comp lib="7" loc="(1370,280)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Igual que addi"/>
    </comp>
    <comp lib="7" loc="(1720,280)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="La genera MARS al traducir li"/>
    </comp>
    <comp lib="7" loc="(2010,280)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="li $t0,5 pasa a addiu $t0,$zero,5: $t0=0101"/>
    </comp>
    <comp lib="7" loc="(1200,300)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="slti"/>
    </comp>
    <comp lib="7" loc="(1270,300)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001010"/>
    </comp>
    <comp lib="7" loc="(1370,300)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = 1 si rs &lt; inm (con signo); si no, 0"/>
    </comp>
    <comp lib="7" loc="(1720,300)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Comparar con una constante"/>
    </comp>
    <comp lib="7" loc="(2010,300)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="slti $t0,$t1,3  con $t1=0001: $t0=1"/>
    </comp>
    <comp lib="7" loc="(1200,320)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="andi"/>
    </comp>
    <comp lib="7" loc="(1270,320)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001100"/>
    </comp>
    <comp lib="7" loc="(1370,320)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rt = rs AND inm (inm rellenado con ceros)"/>
    </comp>
    <comp lib="7" loc="(1720,320)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Quedarse solo con algunos bits"/>
    </comp>
    <comp lib="7" loc="(2010,320)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="andi $t0,$t1,3  con $t1=0110: $t0=0010"/>
    </comp>
    <comp lib="7" loc="(1200,340)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="ori"/>
    </comp>
    <comp lib="7" loc="(1270,340)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
