    <comp lib="7" loc="(260,1530)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Hardware: solo los marcados con SI se comportan de forma especial. Register_File resuelve $zero, $gp y $sp; $v0, $a0 y $ra los resuelve el resto de la CPU."/>
    </comp>
    <comp lib="7" loc="(260,1550)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Convencion: en los demas, el significado es un acuerdo entre programadores. Para la CPU, $t0 y $s0 funcionan igual."/>
    </comp>
    <comp lib="7" loc="(260,1570)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Etiquetas: R8_t0 es el registro numero 8, llamado $t0. Logisim no admite $ en las etiquetas de los componentes."/>
    </comp>
    <comp lib="7" loc="(280,620)" name="Text">
