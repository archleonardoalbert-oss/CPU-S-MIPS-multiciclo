      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(770,770)" name="Text">
      <a name="text" val="Los tuneles ok_ son copias de las salidas es_."/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(60,22)" name="Text">
      <a name="text" val="Instruction_Decoder: identifica la instruccion a partir de op y funct"/>
      <a name="font" val="SansSerif bold 16"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(60,45)" name="Text">
      <a name="text" val="Combinacional, sin reloj ni memoria. Cada instruccion tiene su propia salida es_. Como mucho una vale 1."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="7" loc="(1200,70)" name="Text">
      <a name="font" val="SansSerif bold 16"/>
      <a name="halign" val="left"/>
      <a name="text" val="QUE HACE CADA INSTRUCCION"/>
    </comp>
    <comp lib="7" loc="(1200,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="rs, rt, rd: en la instruccion son el NUMERO de un registro. En esta tabla significan el DATO guardado en ese registro."/>
    </comp>
    <comp lib="7" loc="(1200,120)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="inm: numero de 16 bits de la instruccion.   shamt: cuantas posiciones se desplaza.   dir: direccion de 26 bits de j y jal."/>
    </comp>
    <comp lib="7" loc="(1200,140)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="PC: direccion de la instruccion actual.   $ra: registro donde jal guarda el punto de regreso.   TTY: pantalla de texto de Board."/>
    </comp>
    <comp lib="7" loc="(1200,160)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Byte: 8 bits.   Palabra: 32 bits (4 bytes).   Los valores estan en binario; los ejemplos muestran solo los bits necesarios."/>
    </comp>
    <comp lib="7" loc="(1200,200)" name="Text">
      <a name="font" val="SansSerif bold 13"/>
      <a name="halign" val="left"/>
      <a name="text" val="Instr."/>
