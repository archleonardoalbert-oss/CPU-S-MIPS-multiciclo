    <comp lib="7" loc="(1100,20)" name="Text">
      <a name="text" val="Register_File: 32 registros de 32 bits, dos lecturas combinacionales y una escritura"/>
    </comp>
    <comp lib="7" loc="(1100,45)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Escribe en el flanco de subida de CLK si Reg_Write = 1. RESET es asincrono: borra sin esperar al reloj."/>
    </comp>
    <comp lib="7" loc="(160,680)" name="Text">
      <a name="font" val="SansSerif bold 13"/>
      <a name="halign" val="left"/>
      <a name="text" val="NOTAS"/>
    </comp>
    <comp lib="7" loc="(160,695)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="$zero (R0): enable fijo a 0; nunca cambia."/>
    </comp>
    <comp lib="7" loc="(160,715)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="Por eso WE0 no se usa."/>
    </comp>
    <comp lib="7" loc="(160,730)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="$gp (R28) y $sp (R29): RESET borra el registro,"/>
    </comp>
    <comp lib="7" loc="(160,750)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="y el XOR con la constante da el valor inicial:"/>
    </comp>
    <comp lib="7" loc="(160,770)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="0 XOR K = K. Al escribir, D XOR K XOR K = D."/>
    </comp>
